{
  "enabled": true,
  "name": "Auto Summarize Conversations",
  "description": "After a task completes, ask the agent to summarize key points for memory",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the just-completed task and conversation. Identify 1-3 key learnings, decisions, or insights that should be remembered for future sessions. Format them for addition to the project memory file (.kiro/steering/memory.md)."
  }
}